{
  "name": "@beaconsgg/wikimedia",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "[S] server-only: the paced, maxlag-honouring Wikimedia/Wikidata read client \u2014 articles, Commons license checks, and the Wikidata concordance \u2014 shared by the operator-side Atlas jobs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@beaconsgg/place-taxonomy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:",
    "@beaconsgg/tsconfig": "^1.1.0",
    "@beaconsgg/vitest-config": "^1.1.0"
  }
}
