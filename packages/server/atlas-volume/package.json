{
  "name": "@beaconsgg/atlas-volume",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "[S] server-only: the Atlas volume format \u2014 the contract between Cartographer's publisher and every consumer. Types, the tile layout, the hash spelling, manifest signature verification, and the consumer's sourceId derivation. See apps/atlas/doc/spec/volume-format.md.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@beaconsgg/geo": "^1.1.0",
    "@beaconsgg/identity": "^1.1.0",
    "@beaconsgg/place-taxonomy": "workspace:*",
    "@beaconsgg/protocol-types": "^1.1.0",
    "yauzl": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/yauzl": "catalog:",
    "typescript": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:",
    "@beaconsgg/tsconfig": "^1.1.0",
    "@beaconsgg/vitest-config": "^1.1.0"
  }
}
