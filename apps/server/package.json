{
  "name": "@beaconsgg/server-app",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The Beacon server (NestJS): REST ops, the socket.io live and map channels, and discovery over the @beaconsgg/* packages, on a PostgreSQL store.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs && node scripts/copy-home-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "start": "node dist/main.js",
    "dev": "pnpm build && node dist/main.js",
    "openapi": "pnpm run build && node scripts/openapi.mjs > openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@beaconsgg/atlas-volume": "workspace:*",
    "@beaconsgg/geo": "^1.1.0",
    "@beaconsgg/identity": "^1.1.0",
    "@beaconsgg/place-taxonomy": "workspace:*",
    "@beaconsgg/policy-engine": "workspace:*",
    "@beaconsgg/protocol-types": "^1.1.0",
    "@beaconsgg/server-runtime": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/websockets": "catalog:",
    "exifr": "^7.1.3",
    "pg": "catalog:",
    "pg-copy-streams": "^7.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "swagger-ui-express": "^5.0.1",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@beaconsgg/tsconfig": "^1.1.0",
    "@beaconsgg/vitest-config": "^1.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yazl": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "maplibre-gl": "^6.15.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yazl": "catalog:"
  }
}
