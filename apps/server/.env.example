# Beacon server: example environment. Copy to .env for local dev; never commit real secrets.
# Full reference: src/config.ts, README.md (env tables), ../../doc/deploy.md, and the specs in
# ../../doc/spec/ (mailbox-and-media.md, places.md, runtime-settings.md).
#
# Most of what follows sets a DEFAULT, not the last word. 42 of these are operator policy stored in
# the `settings` table, where an admin changes them without a redeploy: changing one here and
# redeploying lands only if no admin has set it, and a value an admin chose is sticky until they
# reset it. The rest (bootstrap, listen, secrets, filesystem paths, and the access-control settings
# BEACON_ADMINS / BEACON_CORS_ORIGINS / BEACON_TRUST_PROXY) are read from here and nowhere else.
# Which is which is declared in src/settings/registry.ts.

# ── Network / identity ──────────────────────────────────────────────────────
PORT=3001
BEACON_HOST=localhost:3001
BEACON_PUBLIC_URL=http://localhost:3001
BEACON_NAME=Beacon Dev Server
BEACON_COVERAGE=                 # comma-separated geohash prefixes; empty or * = all cells
# BEACON_VERSION=0.0.1           # Docker bakes this at build time (Dockerfile ARG); set here only to override in local dev
BEACON_ACCESS_LEVEL=open         # open | request | private (who may write; see doc/spec/admin-api.md §6)
# BEACON_DESCRIPTION=            # optional operator blurb in the descriptor (<=280 chars)
# BEACON_ABOUT=                  # optional long description, Markdown (<=8192 chars), served at GET /server/about
# BEACON_CONTACT=                # optional operator contact — email / URL (<=200 chars)

# ── Signing key: pick ONE provider ──────────────────────────────────
# env (dev): a BIP39 phrase in the environment. Empty => an ephemeral identity (changes each restart).
BEACON_MNEMONIC=
# file (self-hosted): a chmod-600 file holding a plaintext BIP39 phrase.
# BEACON_KEY_PROVIDER=file
# BEACON_KEY_FILE=/run/secrets/beacon.key
# encrypted-file: an AES-256-GCM key file (make with scripts/encrypt-mnemonic.mjs), unlocked by a passphrase.
# BEACON_KEY_PROVIDER=encrypted-file
# BEACON_KEY_FILE=/run/secrets/beacon.key.enc
# BEACON_KEY_PASSPHRASE=
# kms (managed): a documented seam — deferred (throws until built). BEACON_KEY_SECRET_ID names the secret.
# BEACON_KEY_PROVIDER=kms
# BEACON_KEY_SECRET_ID=

# ── Persistence ─────────────────────────────────────────────────────────────
# Required: the server refuses to start without a Postgres (SQLite was removed, and
# BEACON_DB_PATH is no longer read). `docker compose up -d db` from the repo root serves this one.
BEACON_DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
# BEACON_PG_POOL_SIZE=10
# One server per database, enforced: a booting server waits this long for another one on the same
# database to let go of the writer lock (a redeploy whose old process is still stopping), then
# refuses to start. doc/deploy.md "Topology".
# BEACON_WRITER_LOCK_WAIT_MS=30000

# Backups (doc/deploy.md, "Backup"). May a backup or restore use an S3 endpoint on a private network?
# On by default, for MinIO on a LAN. Off refuses an endpoint that is, or resolves to, a loopback,
# private, link-local or otherwise non-public address: for a hoster whose admins are not trusted
# with its internal network.
# BEACON_BACKUP_PRIVATE_ENDPOINTS=on
# BEACON_MAX_NONCES=50000

# ── Read-only lock ──────────────────────────────────────────────────────────
# Refuses every write with a 503 and pauses background writers. An admin normally sets this live
# (the `writeLocked` setting); here it is the default, and a server restarted with it on starts
# locked. doc/deploy.md "Read-only lock".
# BEACON_WRITE_LOCK=off

# ── Operational ─────────────────────────────────────────────────────────────
BEACON_CORS_ORIGINS=             # comma-separated allowed origins; * = any; empty = no cross-origin access.
                                 # Include the operator console's origin (beacon.admin, e.g.
                                 # http://localhost:3100) when using the admin surface.
# BEACON_TRUST_PROXY=            # Express trust-proxy hops (int) behind N load balancers; default off (trust none)
# The server-wide operator allowlist (../../doc/spec/admin-api.md): account did:keys
# allowed on the SIGNED admin surface — POST /admin/status plus the places admin routes
# (snapshots/import/export/edit/conflicts). Comma-separated. Empty (default) = no admin surface at
# all (the routes 404 as if absent). Never advertised in the descriptor.
# BEACON_ADMINS=
# Write rate limit (POST routes: /rooms, /rooms/:id/ops, /scouts, /profiles, /mailbox, /media,
# /places/admin/*). IP-keyed.
# BEACON_WRITE_RATE_LIMIT_WINDOW_MS=60000
# BEACON_WRITE_RATE_LIMIT_MAX=120
# BEACON_WRITE_RATE_LIMIT_DEBUG=off  # on = verbose per-request rate-limit logging
# Per-DID budgets on the game write surface, keyed on the VERIFIED actor rather than the IP (which
# is over-broad on a shared venue wifi and under-broad once a phone changes network). Two classes,
# so a runaway scout heartbeat cannot spend the budget a jar take needs.
# Player: `place` plus every signed room op, including the read-only `list`.
# BEACON_OP_RATE_LIMIT_WINDOW_MS=60000
# BEACON_OP_RATE_LIMIT_MAX=120
# Relay: POST /scouts (report + cancel). One POST per deployed scout per covering server per minute.
# BEACON_SCOUT_RATE_LIMIT_WINDOW_MS=60000
# BEACON_SCOUT_RATE_LIMIT_MAX=120
# `react` rides ON TOP OF the player class (it charges both), so this can only ever tighten.
# BEACON_REACT_RATE_LIMIT_WINDOW_MS=60000
# BEACON_REACT_RATE_LIMIT_MAX=60
# BEACON_WS_DEBUG=off             # on = verbose socket.io gateway logging
# Deny signed capability/admin requests from these account did:keys (CSV). Entries are SEEDED into
# the durable blocklist table at boot (idempotently); from there admins manage the list live via
# the signed admin.blocklist.* ops; removing a DID from this var alone does NOT unblock it once
# seeded (use admin.blocklist.remove).
# BEACON_BLOCKLIST=

# ── Capability: Mailbox ─────────────────────────────────────────────────────
# A per-recipient notification drop (opaque, signed, server-decided TTL). Advertised in the descriptor.
# BEACON_MAILBOX=on              # off by default; "on" enables /mailbox (send/fetch/ack)
# BEACON_MAILBOX_TTL=604800      # server-decided message TTL, seconds (default 7d) — senders can't set it
# BEACON_MAILBOX_MAX_BODY=256    # max message body bytes (template-sized; 413 over); at most 4096, a larger value fails boot
# BEACON_MAILBOX_RATE_LIMIT_MAX=60     # per-DID send budget per window
# BEACON_MAILBOX_RATE_LIMIT_WINDOW_MS=60000

# ── Capability: Media ───────────────────────────────────────────────────────
# Content-addressed, public, verify-on-ingest media storage. Advertised in the descriptor.
# BEACON_MEDIA=on               # off by default; "on" enables /media (put/get)
# BEACON_MEDIA_MAX_BYTES=5242880 # per-object size cap (413 over). ALSO sizes the JSON body parser
#                                # for the whole server, whether or not media is enabled, because
#                                # media can be switched on at runtime. Lower it to tighten that
#                                # ceiling on a deployment that will never serve media.
# BEACON_MEDIA_QUOTA_BYTES=52428800  # per-DID total storage quota (413 over)
# BEACON_MEDIA_RATE_LIMIT_MAX=60       # per-DID upload budget per window
# BEACON_MEDIA_RATE_LIMIT_WINDOW_MS=60000
# MIME allowlist. NOTE: the EXIF/GPS detect-and-reject privacy guarantee covers IMAGES ONLY — a
# non-image type (e.g. audio/mpeg) is stored as-is and relies on the CLIENT to strip metadata before
# upload. Set this to image types only if you want the server-enforced guarantee for everything.
# BEACON_MEDIA_TYPES=image/jpeg,image/png,image/webp,audio/mpeg

# Blob backend: fs (dev/self-host) | s3 (prod: Cloudflare R2 / DigitalOcean Spaces / AWS).
# BEACON_MEDIA_BACKEND=fs
# BEACON_MEDIA_DIR=beacon-media  # fs backend: local blob directory

# S3 backend (BEACON_MEDIA_BACKEND=s3). Missing bucket/credentials fail closed at boot.
# BEACON_MEDIA_S3_ENDPOINT=      # R2: https://<acct>.r2.cloudflarestorage.com | DO: https://<region>.digitaloceanspaces.com
# BEACON_MEDIA_S3_REGION=auto    # "auto" for R2; e.g. "us-east-1" for DO/AWS
# BEACON_MEDIA_S3_BUCKET=beacon-media
# BEACON_MEDIA_S3_ACCESS_KEY_ID=
# BEACON_MEDIA_S3_SECRET_ACCESS_KEY=
# BEACON_MEDIA_S3_FORCE_PATH_STYLE=false   # true for MinIO / some DO setups
# BEACON_MEDIA_S3_PREFIX=        # optional key prefix within the bucket
# BEACON_MEDIA_CDN_URL=          # public CDN base; set => GET redirects here instead of streaming

# ── Capability: Geocode ─────────────────────────────────────────────────────
# Reverse-geocode a geohash to a city/state/country label, proxying a geocoding provider (Nominatim by
# default) with a server-side cache. Read-only + public (GET /geocode?geohash=). Advertised in the
# descriptor when enabled. Respect the provider's usage policy (attribution + rate) and set a real
# contact in the User-Agent (BEACON_CONTACT or BEACON_GEOCODE_USER_AGENT).
# BEACON_GEOCODE=on              # off by default; "on" enables GET /geocode
# BEACON_GEOCODE_PROVIDER=nominatim
# BEACON_GEOCODE_ENDPOINT=https://nominatim.openstreetmap.org   # self-host or a paid host in prod
# BEACON_GEOCODE_PRECISION=7     # cache-cell precision (default 7, ~150m); coarser drops the neighbourhood
# BEACON_GEOCODE_TTL=2592000     # positive-result cache TTL, seconds (default 30d)
# BEACON_GEOCODE_NEGATIVE_TTL=86400   # empty-result (ocean) cache TTL, seconds (default 1d)
# BEACON_GEOCODE_MIN_INTERVAL_MS=1000 # min spacing between outbound calls (Nominatim asks for <=1 req/s)
# BEACON_GEOCODE_TIMEOUT_MS=8000 # per-request outbound timeout

# ── Capability: Places (the owned, curated place dataset) ───────
# The server OWNS a curated place dataset (../../doc/spec/places.md), populated from
# exactly three inputs (../atlas/doc/spec/beacon-integration.md §6): an Atlas volume import
# (places.atlas.inspect/upload/import), approved player contributions, and the operator's own
# edits/lists — per-source records merge per-field (admin > list: > contrib > atlas:) with a
# conflict/approval queue protecting manual edits, and the public reads (GET /places?cells=&
# categories=, GET /places/:unique) ALWAYS serve from the server's own store — no third-party call
# on any path. The dataset starts empty: an allowlisted admin imports a volume from the console,
# imports a beacon-places/1 GeoJSON list, and curates via places.edit.
# BEACON_PLACES=on               # off by default; "on" enables the reads + the admin surface
# The places admin routes are gated on the server-wide BEACON_ADMINS allowlist (Operational above).
# BEACON_PLACES_PAGE_SIZE=1000   # max + default places per read-query page. Reads are keyset-
#                                # paginated: a full page returns `cursor`; re-query with
#                                # ?cursor=<cursor> (same cells/categories) to walk pages.
# BEACON_PLACES_QUERY_MAX_CELLS=256   # per-query `cells` cap (the shared discovery bound)
# BEACON_PLACES_CELL_PRECISION=6 # place_cells index precision (query floor = precision - 2)
# Player contributions (../../doc/spec/place-proposals.md): let players propose places the dataset lacks and
# descriptor fields for ones it has. Opt-in ON TOP of BEACON_PLACES, and advertised separately as
# the `places-proposals` capability so a game knows whether to offer the affordance. NOTHING a player
# submits is published until an operator approves it via places.proposals.review. Turning this off
# closes new submissions but keeps the existing queue reviewable — a backlog is never stranded.
# BEACON_PLACES_PROPOSALS=on
# BEACON_PLACES_PROPOSAL_RATE_LIMIT_MAX=20  # per-DID submissions per window
# BEACON_PLACES_PROPOSAL_RATE_LIMIT_WINDOW_MS=86400000  # the submission-budget window (default 24h)
# BEACON_PLACES_PROPOSAL_MAX_PENDING=10  # per-DID cap on UNREVIEWED submissions (queue-flood guard)
# BEACON_PLACES_TIMEOUT_MS=25000 # per-request outbound timeout (fetching a hosted volume)
# Atlas volumes are NOT configuration: an operator imports one at runtime from the admin console
# (places.atlas.inspect/upload/import — URL fetched once, or an uploaded archive), and the trust
# decision (the publisher pin) lives in the database beside the data it protects. apps/atlas/README.md.
# Uploaded archives stage in a beacon-atlas-staging/ subdirectory of this dir (default the OS temp
# dir); the server deletes only that subdirectory at boot, never anything else here. A big volume
# briefly needs zip + extracted tree of space there — point this at real disk if /tmp is a small tmpfs.
# BEACON_ATLAS_STAGING_DIR=
# Import media (a volume's photos, a list's hash@host entries) re-hosts by hash-verified transfer
# into the media store — effective ONLY when BEACON_MEDIA is also on; entries are dropped otherwise.
# BEACON_PLACES_IMAGE_MAX_BYTES=10485760  # per-photo download cap (10MB)
# BEACON_PLACES_IMAGE_TIMEOUT_MS=15000
# BEACON_PLACES_IMAGE_MIN_INTERVAL_MS=250  # paced-transfer spacing (volume fetches bypass it)

# ── Outbound (shared by the geo capabilities) ───────────────────────────────
# BEACON_GEOCODE_USER_AGENT=         # identifying UA for outbound geo calls; default derives from version + contact
# ── Anonymous read budgets (per IP) ──
# Backstops, not the primary throttle, and NOT admission gates: they bound how fast a stranger reads,
# not whether they may. Separate buckets so no read class can starve another. See doc/deploy.md.
# BEACON_PLAYER_READ_RATE_LIMIT_MAX=600         # /discovery, /rooms/:id, /profiles/:id, /media/:hash
# BEACON_PLAYER_READ_RATE_LIMIT_WINDOW_MS=60000
# BEACON_DESCRIPTOR_RATE_LIMIT_MAX=600          # /server/descriptor alone: its own bucket, so the hot path cannot close the add-a-server door
# BEACON_DESCRIPTOR_RATE_LIMIT_WINDOW_MS=60000
# BEACON_ABOUT_RATE_LIMIT_MAX=300              # /server/about alone: its own bucket, like the descriptor's
# BEACON_ABOUT_RATE_LIMIT_WINDOW_MS=60000
# BEACON_PLACES_READ_RATE_LIMIT_MAX=120       # per-IP inbound budget for /geocode + /places (per window)
# BEACON_PLACES_READ_RATE_LIMIT_WINDOW_MS=60000
# BEACON_SIGNED_READ_RATE_LIMIT_MAX=300        # POST /mailbox/fetch + /places/proposals/fetch, checked before the signature
# BEACON_SIGNED_READ_RATE_LIMIT_WINDOW_MS=60000

# ── API docs (OpenAPI + Swagger UI) ─────────────────────────────────────────
# Serve the OpenAPI 3.1 spec + interactive Swagger UI, generated from the protocol-types zod schemas.
# Off by default (a public server may not want to advertise its full surface). Same-origin, so CORS
# doesn't gate the UI. Only REST is documented; the socket.io channels are not.
# BEACON_DOCS=on                 # mounts GET /docs (UI) + GET /docs/openapi.json (raw spec)
# BEACON_DOCS_PATH=docs          # mount path (default "docs")

# ── Home page ──────────────────────────────────────────────────────────────────────────────────────
# What a browser gets at `/`: the server's details, its address as text and a QR code, its coverage
# on a map. Anything that does not ask for HTML still gets a 404 at `/`.
# BEACON_HOME=off                                   # on by default
# BEACON_HOME_CONSOLE_URL=https://console.beacons.gg  # the console link, with this server to add; off for none
# BEACON_HOME_SITE_URL=https://beacons.gg           # network link (footer) + <site>/docs (header); off for none
# BEACON_HOME_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png  # loaded by the visitor's browser; off for no map
# BEACON_HOME_STATS=auto                            # room counts: auto = open servers only; on | off
# BEACON_SOURCE_URL=https://git.example.com/my-beacon-server  # footer source link (AGPL §13): set it if you run a modified build; default https://github.com/beacons-gg/beacon.server
